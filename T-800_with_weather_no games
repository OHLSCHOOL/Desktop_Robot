void playTerminatorTheme() {
  // T2 Main Title - Brad Fiedel
  // Structure: Heavy bass pulse + minor chord arpeggios + iconic 5-note motif
  
  #define B_NOTE  123   // B2 - deep industrial bass pulse
  #define E2      82    // E2 - sub bass
  #define A2      110   // A2
  #define E3      165   // E3
  #define A3      220   // A3
  #define C4      262
  #define B3      247
  #define GS3     208
  #define FS3     185
  #define E4      330
  #define D4      294
  #define CS4     277
  #define B4      494

  // Helper lambda-style struct isn't available, so use parallel arrays
  int melody[] = {
    // --- Bass pulse intro (4 heavy hits) ---
    E2,   0,    E2,   0,
    E2,   0,    E2,   0,

    // --- Rising minor arpeggio (E minor: E-G-B) ---
    E3,   A3,   B3,   E4,

    // --- Iconic 5-note motif: the "T2 heartbeat" ---
    E4,   D4,   CS4,  B3,   A3,

    // --- Drop back to bass with tension ---
    0,    E2,   0,    E2,

    // --- Second arpeggio run, higher ---
    GS3,  B3,   E4,   GS3,

    // --- Final motif with resolution drop ---
    B4,   E4,   D4,   CS4,  B3,
    0,    E2,   E2
  };

  int durations[] = {
    // Bass intro
    300, 200, 300, 200,
    300, 200, 300, 350,

    // Rising arpeggio
    150, 150, 150, 400,

    // 5-note motif
    300, 200, 200, 200, 500,

    // Bass drop
    300, 300, 200, 400,

    // Second arpeggio
    150, 150, 200, 350,

    // Final motif
    350, 250, 200, 200, 200,
    200, 300, 500
  };

  int noteGaps[] = {
    // Bass intro
    80, 0, 80, 0,
    80, 0, 80, 0,

    // Rising arpeggio
    30, 30, 30, 150,

    // 5-note motif
    60, 40, 40, 40, 200,

    // Bass drop
    0, 80, 0, 150,

    // Second arpeggio
    30, 30, 30, 100,

    // Final motif
    60, 50, 40, 40, 40,
    0, 80, 0
  };

  int count = sizeof(melody) / sizeof(melody[0]);

  for (int i = 0; i < count; i++) {
    if (melody[i] == 0) {
      noTone(PIN_BUZZER);
    } else {
      tone(PIN_BUZZER, melody[i]);
    }
    delay(durations[i]);
    noTone(PIN_BUZZER);
    if (noteGaps[i] > 0) delay(noteGaps[i]);
  }

  noTone(PIN_BUZZER);
}
void handleAsyncHomingMelody(unsigned long currentMillis) { 
  if (currentHomeNoteIndex < 0) return; 
  if (currentMillis - noteStartTime >= (unsigned long)(homeDurations[currentHomeNoteIndex] * 1.30)) { 
    noTone(PIN_BUZZER); 
    currentHomeNoteIndex++; 
    if (currentHomeNoteIndex < 5) { 
      tone(PIN_BUZZER, homeMelody[currentHomeNoteIndex], homeDurations[currentHomeNoteIndex]); 
      noteStartTime = currentMillis; 
    } else { 
      currentHomeNoteIndex = -1; 
    } 
  } 
}
/***********************************************************************
 FUNCTION: connectToNetwork()

 PURPOSE:
 Connect robot to WiFi and synchronize time services.

 WHY:
 Weather and NTP time require internet access.

 PROCESS:
 1. Connect to WiFi.
 2. Display connection progress.
 3. Sync time.
 4. Pull initial weather report.
***********************************************************************/
void connectToNetwork()

{
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  display.setCursor(0,10);
  display.println("SKYNET CONNECT...");
  display.print("NODE: ");
  display.println(WIFI_SSID);
  display.display();

  Serial.println();
  Serial.println("Connecting To WiFi...");
  Serial.println(WIFI_SSID);

  WiFi.begin(WIFI_SSID, WIFI_PASS);

  int attempts = 0;

  while (WiFi.status() != WL_CONNECTED && attempts < 30)
  {
    delay(500);

    Serial.print(".");
    display.print("[.]");
    display.display();

    attempts++;
  }

  if (WiFi.status() == WL_CONNECTED)
  {
    Serial.println();
    Serial.println("WiFi Connected");

    Serial.print("IP Address: ");
    Serial.println(WiFi.localIP());

    configTime(
      GMT_OFFSET_SEC,
      DAYLIGHT_OFFSET_SEC,
      NTP_SERVER_PRIMARY
    );

    fetchWeatherUpdate();
  }
  else
  {
    Serial.println("WiFi Connection Failed");
  }
}

