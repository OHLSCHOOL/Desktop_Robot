void setup() {
  Serial.begin(115200);
  pinMode(PIN_BUZZER, OUTPUT);
  pinMode(PIN_JOY1_SW, INPUT_PULLUP);
  pinMode(PIN_JOY2_SW, INPUT_PULLUP);

  Wire.begin(8, 9); 
 

Serial.println();
Serial.println("=================================");
Serial.println("T-800 SYSTEM BOOT");
Serial.println("=================================");
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) for(;;);

  connectToNetwork();

  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(18, 7);  display.println("==================");
  display.setCursor(24, 20); display.println("TARGET ACQUIRED");
  display.setCursor(18, 32); display.println("==================");
  display.setCursor(15, 50); display.println(" CALIBRATING JOYS.");
  display.display();

  long sum1X = 0, sum1Y = 0, sum2X = 0;
  for(int i = 0; i < 10; i++) {
    sum1X += analogRead(PIN_JOY1_X); sum1Y += analogRead(PIN_JOY1_Y); sum2X += analogRead(PIN_JOY2_X);
    delay(40);
  }
  center1X = sum1X / 10; center1Y = sum1Y / 10; center2X = sum2X / 10;

  playTerminatorTheme();

  ESP32PWM::allocateTimer(0); ESP32PWM::allocateTimer(1);
  ESP32PWM::allocateTimer(2); ESP32PWM::allocateTimer(3);

  servo1.setPeriodHertz(50); servo2.setPeriodHertz(50);
  servo3.setPeriodHertz(50); servo4.setPeriodHertz(50);
  
servo1.attach(PIN_AXIS1, 544, 2400);
servo1.write(144);
delay(300);

servo2.attach(PIN_AXIS2, 544, 2400);
servo2.write(135);
delay(300);

servo3.attach(PIN_AXIS3, 544, 2400);
servo3.write(156);
delay(300);

servo4.attach(PIN_AXIS4, 544, 2400);
servo4.write(s4.maxLimit);
delay(300);

}

void loop() {
  unsigned long currentMillis = millis();

  // Async Homing Melody Player
  handleAsyncHomingMelody(currentMillis);

  // Throttled Network Weather Fetcher Loop
  if (currentMillis - lastWeatherQueryTime >= WEATHER_QUERY_INTERVAL_MS) {
    lastWeatherQueryTime = currentMillis;
    fetchWeatherUpdate();
  }

  // Core Kinematics Update Loop
  if (currentMillis - lastUpdateTime >= loopDelayMs) {
    lastUpdateTime = currentMillis;
    processKinematicsEngine();
  }

  // Throttled Async OLED Screen Update Loop
  if (currentMillis - lastOledTime >= oledDelayMs) {
    lastOledTime = currentMillis;
    starAnimateFrame++; 
    updateOLED();
  }
}
