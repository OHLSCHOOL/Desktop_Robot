/***********************************************************************
 FUNCTION: fetchWeatherUpdate()

 PURPOSE:
 Connects to Open-Meteo and retrieves current weather conditions.

 WHY:
 The robot uses live weather intelligence for display on the OLED.

 PROCESS:
 1. Verify WiFi connection.
 2. Build API request URL.
 3. Send HTTPS request.
 4. Receive JSON response.
 5. Parse temperature and weather code.
 6. Store values for OLED display.

 OUTPUTS:
   webTemperature
   weatherCode
***********************************************************************/
void fetchWeatherUpdate()
{
  if (WiFi.status() != WL_CONNECTED)
  {
    Serial.println("Weather Update Aborted - No WiFi");
    return;
  }

  WiFiClient client;
  HTTPClient http;

  String queryUrl =
    "https://api.open-meteo.com/v1/forecast?"
    "latitude=" + String(WEATHER_LAT) +
    "&longitude=" + String(WEATHER_LON) +
    "&current=temperature_2m,weather_code"
    "&temperature_unit=fahrenheit"
    "&wind_speed_unit=mph"
    "&timezone=auto";

  Serial.println();
  Serial.println("=================================");
  Serial.println("OPEN METEO WEATHER REQUEST");
  Serial.println(queryUrl);
  Serial.println("=================================");

  http.begin(queryUrl); // Uses WiFiClientSecure internally for HTTPS

  int httpCode = http.GET();

  Serial.print("HTTP Response Code: ");
  Serial.println(httpCode);

  if (httpCode == HTTP_CODE_OK)
  {
    String payload = http.getString();

    Serial.println("------ RAW WEATHER JSON ------");
    Serial.println(payload);
    Serial.println("------------------------------");

    JsonDocument filter;
    filter["current"]["temperature_2m"] = true;
    filter["current"]["weather_code"] = true;

    JsonDocument doc;

    DeserializationError error =
      deserializeJson(
        doc,
        payload,
        DeserializationOption::Filter(filter)
      );

    if (!error)
    {
      webTemperature =
        doc["current"]["temperature_2m"] | 0.0;

      weatherCode =
        doc["current"]["weather_code"] | 0;

      Serial.println("------ WEATHER DATA ------");

      Serial.print("Temperature: ");
      Serial.println(webTemperature);

      Serial.print("Weather Code: ");
      Serial.println(weatherCode);

      Serial.println("--------------------------");
    }
    else
    {
      Serial.print("JSON Parse Error: ");
      Serial.println(error.c_str());
    }
  }
  else
  {
    Serial.print("Open-Meteo HTTP Error: ");
    Serial.println(httpCode);
  }

  http.end();
}

//OLED Tactical Displays & Drone Asset Graphics 
void drawVisualBar(int x, int y, float current, int minVal, int maxVal) { 
  int width = 45; 
  int fillWidth = map((int)round(current), minVal, maxVal, 0, width); 
  display.drawRect(x, y, width, 6, SSD1306_WHITE); 
  display.fillRect(x, y, fillWidth, 6, SSD1306_WHITE); 
} 

void drawWeatherIcon(int x, int y, int code) { 
  // Redefined weather icons as tactical environment indicators
  if (code <= 1) { // Clear/Sunny -> High Visibility
    display.drawCircle(x + 10, y + 10, 5, SSD1306_WHITE); 
    for (int i = 0; i < 360; i += 45) { 
      float rad = i * 0.0174532925; 
      display.drawLine(x + 10 + cos(rad) * 7, y + 10 + sin(rad) * 7, x + 10 + cos(rad) * 10, y + 10 + sin(rad) * 10, SSD1306_WHITE); 
    } 
  } else if (code <= 48) { // Cloudy -> Thermal Cover
    display.fillCircle(x + 6, y + 12, 4, SSD1306_WHITE); 
    display.fillCircle(x + 12, y + 10, 6, SSD1306_WHITE); 
    display.fillCircle(x + 17, y + 12, 4, SSD1306_WHITE); 
    display.fillRect(x + 6, y + 12, 12, 4, SSD1306_WHITE); 
  } else if ((code >= 51 && code <= 67) || (code >= 80 && code <= 82) || code >= 95) { // Rain -> Moisture Interference
    display.fillCircle(x + 8, y + 8, 4, SSD1306_WHITE); 
    display.fillCircle(x + 13, y + 7, 5, SSD1306_WHITE); 
    display.fillRect(x + 8, y + 9, 8, 3, SSD1306_WHITE); 
    display.drawLine(x + 7, y + 14, x + 5, y + 18, SSD1306_WHITE); 
    display.drawLine(x + 11, y + 14, x + 9, y + 18, SSD1306_WHITE); 
    display.drawLine(x + 15, y + 14, x + 13, y + 18, SSD1306_WHITE); 
  } else { // Snow -> Freeze Risk
    display.drawLine(x + 10, y + 2, x + 10, y + 16, SSD1306_WHITE); 
    display.drawLine(x + 3, y + 9, x + 17, y + 9, SSD1306_WHITE); 
    display.drawLine(x + 5, y + 4, x + 15, y + 14, SSD1306_WHITE); 
    display.drawLine(x + 5, y + 14, x + 15, y + 4, SSD1306_WHITE); 
  } 
} 

String getWeatherString(int code) { 
  if (code == 0) return "OPTIMAL"; 
  if (code == 1) return "CLEAR"; 
  if (code == 2) return "CLOUDY"; 
  if (code == 3) return "OVERCAST"; 
  if (code == 45 || code == 48) return "VIS OBSTRUCT"; 
  if (code >= 51 && code <= 55) return "LIGHT RADAR HUMID"; 
  if (code >= 61 && code <= 65) return "HEAVY PRECIP"; 
  if (code >= 71 && code <= 77) return "ICING HAZARD"; 
  if (code >= 80 && code <= 82) return "SCAN BLOCKED"; 
  if (code >= 85 && code <= 86) return "SEVERE BLIZZARD"; 
  if (code >= 95) return "EMP THREAT"; 
  return "UNKNOWN ENV"; 
} 

