//Kinematics Tracking & Core Computation Engine

void processKinematicsEngine() {
  int j1x = analogRead(PIN_JOY1_X);
  int j1y = analogRead(PIN_JOY1_Y);
  int j2x = analogRead(PIN_JOY2_X);
  int j1sw = digitalRead(PIN_JOY1_SW);
  int j2sw = digitalRead(PIN_JOY2_SW);

  int offset1X = j1x - center1X;
  int offset1Y = j1y - center1Y;
  int offset2X = j2x - center2X;

  // Track user movements to manage the screen timeout
  if (abs(offset1X) > DEADBAND || abs(offset1Y) > DEADBAND || abs(offset2X) > DEADBAND || j1sw == LOW || j2sw == LOW) {
    lastInactivityMarker = millis();
    isScreenSaverActive = false; 
  }
  if (millis() - lastInactivityMarker >= TIMEOUT_THRESHOLD_MS) {
    isScreenSaverActive = true; 
  }

  // Auto Reset Homing Flag when destinations are hit
  if (isHomingModeActive && 
    abs(s1.currentAngle - 144) < 1.0 && 
    abs(s2.currentAngle - 135) < 1.0 && 
    abs(s3.currentAngle - 156) < 1.0 && 
    abs(s4.currentAngle - s4.maxLimit) < 1.0) {
  isHomingModeActive = false;
}
  

  // Update target coordinates from Joysticks
  if (!isHomingModeActive) {
    if (abs(offset1X) > DEADBAND) s1.targetAngle += (offset1X > 0) ? 3 : -3; //axis1 joystick direction
    if (abs(offset1Y) > DEADBAND) s2.targetAngle += (offset1Y > 0) ? -3 : 3; //axis2 joystick direction
    if (abs(offset2X) > DEADBAND) s3.targetAngle += (offset2X > 0) ? 4 : -4; //axis3 joystick direction
  }

  // Handle Home Positioning Request Button
  if (j1sw == LOW && lastHomeButtonState == HIGH) {
    s1.targetAngle = 144; s2.targetAngle = 135; s3.targetAngle = 156;
    gripperClosed = true; s4.targetAngle = s4.maxLimit; 
    
    isHomingModeActive = true; 
    currentHomeNoteIndex = 0; 
    noteStartTime = millis();
    tone(PIN_BUZZER, homeMelody[0], homeDurations[0]); // Fixed: Given single note parameters
  }
  lastHomeButtonState = j1sw;

  // Handle Gripper Toggle Button Input
  if (j2sw == LOW && lastGripButtonState == HIGH) {
     isHomingModeActive = false;
     gripperClosed = !gripperClosed;
     s4.targetAngle = gripperClosed ? s4.maxLimit : s4.minLimit;
     if(gripperClosed) { tone(PIN_BUZZER, 880, 30); delay(35); tone(PIN_BUZZER, 1760, 40); } 
     else { tone(PIN_BUZZER, 1760, 30); delay(35); tone(PIN_BUZZER, 880, 40); }
  }
  lastGripButtonState = j2sw;

  // Mechanical Hardware Safety Enforcements
  s1.targetAngle = constrain(s1.targetAngle, s1.minLimit, s1.maxLimit);
  s2.targetAngle = constrain(s2.targetAngle, s2.minLimit, s2.maxLimit);
  s3.targetAngle = constrain(s3.targetAngle, s3.minLimit, s3.maxLimit);
  s4.targetAngle = constrain(s4.targetAngle, s4.minLimit, s4.maxLimit);

  // Linear Interpolation Processing (LERP)
  if (abs(s1.targetAngle - s1.currentAngle) > 0.2) s1.currentAngle += (s1.targetAngle - s1.currentAngle) * SMOOTH_SPEED_1; else s1.currentAngle = s1.targetAngle;
  if (abs(s2.targetAngle - s2.currentAngle) > 0.2) s2.currentAngle += (s2.targetAngle - s2.currentAngle) * SMOOTH_SPEED_2; else s2.currentAngle = s2.targetAngle;
  if (abs(s3.targetAngle - s3.currentAngle) > 0.2) s3.currentAngle += (s3.targetAngle - s3.currentAngle) * SMOOTH_SPEED_3; else s3.currentAngle = s3.targetAngle;
  if (abs(s4.targetAngle - s4.currentAngle) > 0.2) s4.currentAngle += (s4.targetAngle - s4.currentAngle) * SMOOTH_SPEED_4; else s4.currentAngle = s4.targetAngle;

  // Send Final Computed Hardware Positions To Physical Servos
  servo1.write((int)round(s1.currentAngle));
  servo2.write((int)round(s2.currentAngle));
  servo3.write((int)round(s3.currentAngle));
  servo4.write((int)round(s4.currentAngle));
}

